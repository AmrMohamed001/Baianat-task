PORT=3000
NODE_ENV=production

OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# DB
DB_HOSTER=db
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_POOL=

## Seed Admin User
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_FULLNAME=
ADMIN_PASSWORD=

## Auth
JWT_SECRET=
JWT_EXPIRES_IN=

## Vendors
DT_COMMISSION_RATE=

## REDIS
REDIS_HOST=redis
REDIS_PORT=6379

## STRIPE
STRIPE_WEBHOOK_SECRET=
Publishable=
STRIPE_SECRET_KEY=

## NOTIFICATIONS (SMTP / GMAIL)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

## S3 uploads (LocalStack dev,aws S3 production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=my-app-bucket
# S3 address, in production set empty and aws sdk will resolve 
S3_ENDPOINT=
# true for LocalStack, false for aws S3(decides where the bucket name goes in the file's web address.)
S3_FORCE_PATH_STYLE=true
S3_UPLOAD_EXPIRES_SECONDS=300
S3_BASE_URL=http://localhost:4566/my-app-bucket

## LocalStack (compose)
SERVICES=s3
