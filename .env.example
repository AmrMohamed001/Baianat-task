PORT=3000
NODE_ENV=development

OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# DB
DB_HOSTER=db
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_POOL=

## Seed Admin User
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_FULLNAME=
ADMIN_PASSWORD=

## Auth
JWT_SECRET=
JWT_EXPIRES_IN=

## Vendors
DT_COMMISSION_RATE=

## REDIS
REDIS_HOST=redis
REDIS_PORT=6379

## STRIPE
STRIPE_WEBHOOK_SECRET=
Publishable=
STRIPE_SECRET_KEY=

## SUPERADMIN_ID
SUPERADMIN_ID_FOR_COMMISIION=

## NOTIFICATIONS (SMTP / GMAIL)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

## S3 uploads (LocalStack in dev, real S3 in production: only these values change)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=my-app-bucket
# S3 address, used by the API and by the browser (it is part of the upload URL). LocalStack: http://localstack:4566 (needs `127.0.0.1 localstack` in /etc/hosts). Leave empty for real S3.
S3_ENDPOINT=http://localstack:4566
# true for LocalStack/MinIO, false for real S3
S3_FORCE_PATH_STYLE=true
# Seconds a presigned upload stays valid
S3_UPLOAD_EXPIRES_SECONDS=300
# Base URL of public objects, the key is appended: S3_PUBLIC_URL/key
S3_PUBLIC_URL=http://localhost:4566/my-app-bucket

## LocalStack (compose)
SERVICES=s3
