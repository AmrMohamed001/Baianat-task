PORT=3000
NODE_ENV=production

## Nest Observe (monitoring)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

## DB (Docker Compose also uses these to create the database)
DB_HOSTER=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=starter_ql
DB_POOL=10

## Seed Admin User (read by the SeedSuperAdmin migration)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_FULLNAME=Super Admin
ADMIN_PASSWORD=

## Auth
JWT_SECRET=
JWT_EXPIRES_IN=1d

## Vendors (commission percent given to new vendors)
DT_COMMISSION_RATE=10

## REDIS
REDIS_HOST=redis
REDIS_PORT=6379

## STRIPE
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=

## NOTIFICATIONS (SMTP / GMAIL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

## S3 uploads (AWS S3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# leave empty for AWS, the SDK finds S3 itself. Set only for an S3-compatible service
S3_ENDPOINT=
# false for AWS S3 (where the bucket name goes in file addresses)
S3_FORCE_PATH_STYLE=false
S3_UPLOAD_EXPIRES_SECONDS=300
# https://<bucket>.s3.<region>.amazonaws.com or a CDN domain
S3_BASE_URL=
